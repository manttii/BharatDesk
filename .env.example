# Copy to .env. Never commit .env. All secrets come from the environment only.
ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./bharatdesk.db
AUTO_MIGRATE=true

# Telegram (leave the token empty to run without Telegram; the app still boots)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# Only for TELEGRAM_MODE=webhook:
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Used by scripts/bootstrap.py to print links when no token is configured
TELEGRAM_BOT_USERNAME=

# Speech-to-text (Groq Whisper) and extraction (Gemini). Model names are NEVER hardcoded:
# set them yourself. With a key but no model name the app refuses to start.
GROQ_API_KEY=
WHISPER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Or NVIDIA hosted models (OpenAI-compatible). Set LLM_PROVIDER only if BOTH providers have keys.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=60
# Only if Groq rejects Telegram's OGG/Opus: always convert to WAV with ffmpeg first.
STT_FORCE_CONVERT=false

# Media + conversation limits
MAX_PDF_BYTES=20971520
# Set false only in tests that use a fake clock (background loops use the real one)
BACKGROUND_TASKS=true
MAX_PDF_PAGES=50
BILL_CONCURRENCY=3
MEDIA_DIR=./media
MIN_VOICE_MS=1500
MAX_VOICE_SECONDS=120
CONVERSATION_TTL_MINUTES=30
APPROVAL_TTL_HOURS=24
STRANDED_AFTER_MINUTES=10
RETENTION_SWEEP_HOURS=24

# Optional cost estimates, as integers in paise. Left empty on purpose: prices change, so
# the numbers must come from your own bill. (Empty = cost_paise stays NULL.)
STT_COST_PAISE_PER_MINUTE=
LLM_COST_PAISE_PER_1K_TOKENS=

# Photos / handwritten slips
MAX_PHOTO_BYTES=10485760
MIN_PHOTO_DIMENSION=300
SLIP_MIN_LEGIBILITY=0.5

# Google Sheets sync (service account). Use EITHER a file path OR the JSON itself.
# Then share your sheet (Editor) with the service account's client_email and send /sheet <link>.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
SYNC_INTERVAL_SECONDS=15
SYNC_MAX_ATTEMPTS=8

# Boss dashboard (/dashboard command). The secret must be >= 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SECRET=
PUBLIC_BASE_URL=
DASHBOARD_LINK_TTL_MINUTES=60

# Browser sandbox at /sandbox (loopback only; forced off when ENV=prod)
SANDBOX_ENABLED=true

INVITE_TTL_HOURS=24
PENDING_ACTION_TTL_MINUTES=10
CONSENT_VERSION=v1
RATE_LIMIT_PER_MINUTE=30
