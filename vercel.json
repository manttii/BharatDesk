{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "app/**",
      "excludeFiles": "{tests/**,evals/**,samples/**,scripts/**,migrations/**,media/**,.venv/**,.github/**,*.db}"
    }
  }
}
